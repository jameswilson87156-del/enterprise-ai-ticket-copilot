# Copy this file to deploy/staging/.env and replace every CHANGE_ME value.
# This is a staging scaffold. It does not deploy anything by itself.

TICKET_HOST=ticket.staging.example.com
TICKET_HTTP_PORT=8087
TICKET_PUBLIC_HTTP_PORT=80
TICKET_PUBLIC_HTTPS_PORT=443
ACME_EMAIL=operator@example.com

# Existing private RDS endpoint; initialize schema through DATABASE_UPGRADES.md.
TICKET_DB_URL=jdbc:mysql://CHANGE_ME_private_rds:3306/enterprise_ticket_staging?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai
TICKET_DB_USERNAME=ticket_staging
TICKET_DB_PASSWORD=CHANGE_ME_mysql_application_password

# OIDC is mandatory for staging/production. The issuer must expose discovery
# and JWKS endpoints reachable from the ticket-api container.
TICKET_AUTH_ISSUER_URI=https://id.example.com/realms/enterprise
TICKET_AUTH_AUDIENCE=ticket-api
TICKET_AUTH_ROLES_CLAIM=roles
TICKET_AUTH_PRINCIPAL_CLAIM=sub
VITE_TICKET_AUTH_CLIENT_ID=CHANGE_ME_public_oidc_client_id
VITE_TICKET_AUTH_SCOPE=openid profile email

# The API key is server-only. Never put it in VITE_* variables or commit it.
# Set these values in the deployment secret store or in the untracked .env.
TICKET_AI_PROVIDER=deepseek
TICKET_AI_BASE_URL=https://api.deepseek.com/v1
TICKET_AI_PROTOCOL=chat-completions
TICKET_AI_MODEL=deepseek-chat
TICKET_AI_API_KEY=CHANGE_ME_runtime_secret
TICKET_AI_FALLBACK_TO_LOCAL=false
TICKET_AI_RATE_LIMIT_LIMIT=6
TICKET_AI_RATE_LIMIT_WINDOW_SECONDS=60
